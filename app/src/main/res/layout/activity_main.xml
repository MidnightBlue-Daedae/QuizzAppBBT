<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1C5B"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Big Bang Theory Quiz"
        android:textColor="@color/white"
        android:textSize="90dp"
        android:layout_gravity="center"
        android:textStyle="bold"
        />

    <TextView
            android:id="@+id/question"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="True or False: Sheldon Cooper's signature catchphrase after pulling a prank or making a joke is 'Bazinga!'"
            android:textStyle="bold"
            android:textSize="60dp"
            android:textColor="@color/white"
            android:layout_marginTop="70dp"
            android:textAlignment="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="60dp">

            <Button
                android:id="@+id/True"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/black"
                android:text="TRUE"
                android:textSize="70dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                />
            <Space
                android:layout_width="30dp"
                android:layout_height="30dp"/>

            <Button
                android:id="@+id/False"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:text="FALSE"
                android:textSize="70dp"
                android:backgroundTint="@color/black"/>

    </LinearLayout>

    <Button
        android:id="@+id/restart"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restart"
        android:textStyle="bold"
        android:textSize="60dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/black"/>
    <Button
        android:id="@+id/showScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Show Score"
        android:textStyle="bold"
        android:textSize="50dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/black"
        android:visibility="gone"/>


</LinearLayout>