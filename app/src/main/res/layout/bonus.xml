<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1C5B"
    android:gravity="center"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BONUS QUESTION!!!"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="80dp"
        android:layout_gravity="center"/>
    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="50dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:text="The iconic elevator in Sheldon and Leonard's apartment building was out of order for the entire series and was never fixed in any episode."
        android:textAlignment="center"
        android:layout_marginTop="30dp"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="30dp">

        <Button
            android:id="@+id/True"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="True"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="50dp"
            android:backgroundTint="@color/black"
            android:layout_weight="1"/>
        <Space
            android:layout_width="20dp"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/False"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="False"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="50dp"
            android:backgroundTint="@color/black"
            android:layout_weight="1"/>


    </LinearLayout>
    <Button
        android:id="@+id/newScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show new Score"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="50dp"
        android:backgroundTint="@color/black"
        android:visibility="gone"/>




</LinearLayout>